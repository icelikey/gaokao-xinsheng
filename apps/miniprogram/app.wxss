/* Shared retro skin. Higher-specificity selectors retain existing page layouts. */
page {
  min-height: 100vh;
  color: #302b23;
  background: #eee5d2;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.page { min-height: 100vh; padding: 40rpx 32rpx 96rpx; box-sizing: border-box; }
.eyebrow { color: #876137; font-size: 24rpx; font-weight: 800; letter-spacing: 2rpx; }
.title { margin: 18rpx 0; color: #302b23; font-size: 64rpx; font-weight: 900; line-height: 1.3; font-family: "STSong", "Songti SC", "SimSun", serif; }
.lead, .muted { color: #71604c; font-size: 28rpx; line-height: 1.8; }
.panel { margin-top: 28rpx; border: 2rpx solid #d0bea0; border-radius: 4rpx; padding: 28rpx; background: #fbf6e9; box-sizing: border-box; box-shadow: 3rpx 8rpx 20rpx #4b332015; }
.buttonRow { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 28rpx; }
.page .primaryButton, .page .secondaryButton { min-height: 92rpx; border-radius: 4rpx; padding: 0 28rpx; font-size: 30rpx; font-weight: 800; line-height: 92rpx; }
.page .primaryButton { color: #fff8e8; background: #913a32; box-shadow: inset 0 0 0 6rpx #ffffff18; }
.page .secondaryButton { color: #663b31; border: 2rpx solid #c0a787; background: #faf4e5; }
.page button[disabled] { opacity: .55; }
.metricGrid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx; margin-top: 24rpx; }
.page .metric { border: 2rpx solid #d0bea0; border-radius: 4rpx; padding: 24rpx; background: #f8efd9; }
.page .metricValue { display: block; color: #913a32; font: 900 56rpx Georgia,serif; }
.metricLabel { display: block; margin-top: 8rpx; color: #71604c; font-size: 24rpx; }
.page.homePage { background: #203f37; border-top: 12rpx solid #805a3b; }
.page.homePage .title { color: #f5edd7; font-size: 88rpx; }
.page.homePage .eyebrow { color: #e1cf9e; }
.page.homePage .lead { color: #d5d8c2; }
.page .statusText, .page .candidateTitle { color: #913a32; }
.page .matchPanel, .page .pickerCell, .page .candidateCard { border-color: #c8b492; border-radius: 4rpx; background: #fbf6e9; }
.page .candidateCard { border-color: #913a32; }
.page .pickerCell text { color: #71604c; }
.page .pickerCell strong { color: #302b23; }
.page .topbar { padding-bottom: 24rpx; border-bottom: 4rpx double #bba483; color: #663b31; }
.page .answerNumber, .page .choiceButton, .page .hintRow button { border-radius: 4rpx; background: #fbf6e9; color: #302b23; border-color: #c5b193; min-height: 88rpx; }
.page .answerNumber.answered { background: #203f37; border-color: #203f37; color: #fff8e8; }
.page .choiceButton.selected { background: #913a32; border-color: #913a32; color: #fff8e8; }
.page .answerNumber.active { border: 4rpx solid #a97524; }
.page .questionMeta text { color: #71604c; border-color: #d0bea0; border-radius: 4rpx; background: #f1e6d0; }
.page .questionStem { color: #302b23; font-family: "STSong", "Songti SC", serif; font-size: 38rpx; line-height: 1.8; }
.page .answerInput { color: #302b23; border-color: #baa584; border-radius: 4rpx; background: #fffaf0; line-height: 1.9; }
.page .hintRow { grid-template-columns: repeat(2,minmax(0,1fr)); }
