.sharePage {
  display: flex;
  align-items: center;
  background:
    linear-gradient(160deg, rgba(6, 24, 50, 0.94), rgba(11, 61, 145, 0.78)),
    #061832;
}

.publicCard {
  width: 100%;
}

.posterImage {
  width: 100%;
  border: 1rpx solid #d8dfeb;
  border-radius: 12rpx;
  background: #fff;
}

.shareMeta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0;
}

.shareMeta text {
  border: 2rpx solid #d8dfeb;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
}
