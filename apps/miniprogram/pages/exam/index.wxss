.topbar {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 800;
}

.answerGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14rpx;
  margin: 24rpx 0;
}

.answerNumber,
.choiceButton,
.hintRow button {
  min-height: 76rpx;
  border: 2rpx solid rgba(12, 24, 48, 0.14);
  border-radius: 14rpx;
  color: #0c1830;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.answerNumber.answered,
.choiceButton.selected {
  color: #ffffff;
  border-color: #0b3d91;
  background: #0b3d91;
}

.answerNumber.active {
  border-color: #40c9d0;
}

.questionMeta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.questionMeta text {
  border: 2rpx solid rgba(12, 24, 48, 0.14);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
}

.questionStem {
  margin: 28rpx 0;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.35;
}

.choiceGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.answerInput {
  width: 100%;
  min-height: 240rpx;
  border: 2rpx solid rgba(12, 24, 48, 0.14);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.7;
}

.hintRow {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin: 20rpx 0;
}
